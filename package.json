{
  "name": "windform",
  "version": "0.1.0",
  "description": "Tailwind 4.3 shadcn-token visual compatibility layer for a documented Bootstrap 5.3.8 component subset",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/md-riaz/Windform.git"
  },
  "homepage": "https://github.com/md-riaz/Windform#readme",
  "bugs": {
    "url": "https://github.com/md-riaz/Windform/issues"
  },
  "keywords": [
    "tailwindcss",
    "tailwindcss-v4",
    "bootstrap",
    "bootstrap-5",
    "shadcn",
    "design-tokens",
    "css"
  ],
  "files": [
    "src/windform.css",
    "tailwind.config.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "style": "./src/windform.css",
  "exports": {
    "./windform.css": "./src/windform.css",
    "./tailwind.config": "./tailwind.config.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:admin": "node ./scripts/build-admin-panel.cjs",
    "build": "npm run build:admin && tailwindcss -i ./src/windform.css -o ./docs/assets/windform.css --minify",
    "check": "npm run build && node ./scripts/check-build.cjs && node ./scripts/check-package.cjs && node ./scripts/check-mojibake.cjs",
    "test:compat": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test": "npm run check && npm run test:compat",
    "dev": "tailwindcss -i ./src/windform.css -o ./docs/assets/windform.css --watch"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.8",
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "bootstrap": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.3",
    "bootstrap": "5.3.8",
    "tailwindcss": "4.3.3"
  }
}
